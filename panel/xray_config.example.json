{
    "log": {
        "loglevel": "info"
    },
    "inbounds": [
        {
            "tag": "VMess TCP",
            "listen": "0.0.0.0",
            "port": 8444,
            "protocol": "vmess",
            "settings": {
                "clients": []
            },
            "streamSettings": {
                "network": "raw",
                "rawSettings": {
                    "acceptProxyProtocol": false
                },
                "security": "none"
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ]
            }
        },
        {
            "tag": "VMess Websocket",
            "listen": "/run/sockets/xray-vmess-ws.sock,0666",
            "protocol": "vmess",
            "settings": {
                "clients": []
            },
            "streamSettings": {
                "network": "ws",
                "wsSettings": {
                    "acceptProxyProtocol": false,
                    "path": "/vmsws"
                },
                "security": "none"
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ]
            }
        },
        {
            "tag": "VMess GRPC REALITY",
            "listen": "/run/sockets/xray-vmess-grpc.sock,0666",
            "protocol": "vmess",
            "settings": {
                "clients": []
            },
            "streamSettings": {
                "network": "grpc",
                "grpcSettings": {
                    "serviceName": "xyz"
                },
                "sockopt": {
                    "acceptProxyProtocol": true
                },
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "target": "/run/sockets/nginx-main.sock",
                    "xver": 2,
                    "spiderX": "/",
                    "serverNames": [
                        "vmg.domain.tld"
                    ],
                    "privateKey": "docker compose exec -ti node xray x25519",
                    "shortIds": [
                        "Generate shortIds",
                        "for i in {1..4}; do openssl rand -hex 8; done | jq -R . | jq -s ."
                    ]
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ]
            }
        },

server_tokens off;

server {
    listen unix:/run/sockets/nginx-main.sock ssl proxy_protocol;  # H2C server with PROXY protocol reception

    server_name $SERVER_NAME_HTTPS;

    ssl_certificate /etc/nginx/ssl/$SERVER_NAME_HTTPS.crt;
    ssl_certificate_key /etc/nginx/ssl/$SERVER_NAME_HTTPS.key;

    include /nextcloud/nextcloud.conf;

    location /vmsws {
        if ($http_upgrade != "websocket") {
            return 404;
        }
        proxy_redirect off;
        proxy_pass http://unix:/run/sockets/xray-vmess-ws.sock;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $proxy_protocol_addr;
        proxy_set_header X-Forwarded-For $proxy_protocol_addr;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /vlsws {
        if ($http_upgrade != "websocket") {
            return 404;
        }
        proxy_redirect off;
        proxy_pass http://unix:/run/sockets/xray-vless-ws.sock;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $proxy_protocol_addr;
        proxy_set_header X-Forwarded-For $proxy_protocol_addr;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /trws {
        if ($http_upgrade != "websocket") {
            return 404;
        }
        proxy_redirect off;
        proxy_pass http://unix:/run/sockets/xray-trojan-ws.sock;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $proxy_protocol_addr;
        proxy_set_header X-Forwarded-For $proxy_protocol_addr;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
